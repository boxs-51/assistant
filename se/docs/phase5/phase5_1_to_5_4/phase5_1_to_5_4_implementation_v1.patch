+from __future__ import annotations
+
+from typing import Any
+
+from ..contracts.context import AgentExecutionContext
+from ..contracts.context_builder import (
+    AgentContextRequest,
+    AgentContextSnapshot,
+    ContextBuilderPort,
+)
+from ..contracts.inference import InferenceMessage, InferenceToolDefinition
+
+
+class ContextBuilderAdapter(ContextBuilderPort):
+    """Bridges the Agent context contract to the existing ContextRuntime.
+
+    This adapter is deliberately read-only with respect to storage. It creates
+    a per-iteration immutable snapshot and does not expose ContextEngine to
+    AgentRuntime callers.
+    """
+
+    def __init__(self, context_runtime: Any, capability_runtime: Any | None = None):
+        self._context_runtime = context_runtime
+        self._capability_runtime = capability_runtime
+
+    async def build(
+        self,
+        context: AgentExecutionContext,
+        request: AgentContextRequest,
+    ) -> AgentContextSnapshot:
+        if context.execution_id != request.execution_id:
+            raise ValueError("Context request execution_id does not match execution context.")
+        if request.iteration < 1:
+            raise ValueError("Context iteration must be >= 1.")
+
+        context.ensure_active()
+
+        engine = getattr(self._context_runtime, "context_engine", None)
+        if engine is None:
+            raise RuntimeError("ContextRuntime is not initialized.")
+
+        loaded = await engine.load_context(context.session_id, context.identity)
+        messages: list[InferenceMessage] = []
+
+        if loaded.session is not None:
+            messages.extend(
+                InferenceMessage(
+                    role=message.role,
+                    content=message.content,
+                    metadata=getattr(message, "metadata", {}) or {},
+                )
+                for message in loaded.session.messages
+            )
+
+        if request.prior_messages:
+            messages = [
+                InferenceMessage.model_validate(message)
+                for message in request.prior_messages
+            ]
+
+        input_payload = dict(request.input or context.input)
+        if input_payload:
+            prompt = input_payload.get("prompt")
+            if prompt is None:
+                prompt = input_payload.get("content")
+            if prompt is not None and (not messages or messages[-1].role != "user"):
+                messages.append(InferenceMessage(role="user", content=prompt))
+
+        if request.tool_results:
+            for result in request.tool_results:
+                messages.append(
+                    InferenceMessage(
+                        role="tool",
+                        content=result.output if result.success else result.error_message,
+                        metadata={
+                            "tool_call_id": result.tool_call_id,
+                            "capability_id": result.capability_id,
+                            "is_error": not result.success,
+                        },
+                    )
+                )
+
+        tools: list[InferenceToolDefinition] = []
+        registry = getattr(getattr(self._capability_runtime, "registry", None), "get", None)
+        agent_tools = list(getattr(context.agent, "tools", []) or [])
+        capability_registry = getattr(self._capability_runtime, "registry", None)
+        if capability_registry is not None:
+            for capability_id in agent_tools:
+                record = capability_registry.get(capability_id)
+                if record is None or not record.executable:
+                    continue
+                definition = record.definition
+                tools.append(
+                    InferenceToolDefinition(
+                        name=definition.name,
+                        description=definition.description,
+                        parameters=definition.parameters,
+                    )
+                )
+
+        return AgentContextSnapshot(
+            execution_id=context.execution_id,
+            iteration=request.iteration,
+            messages=messages,
+            tools=tools,
+            token_estimate=sum(len(str(message.content or "")) // 4 for message in messages),
+            metadata={
+                **context.metadata,
+                **dict(request.metadata),
+                "agent_id": context.agent_id,
+                "session_id": context.session_id,
+            },
+        )
