@@ -0,0 +1,181 @@
+from __future__ import annotations
+
+import asyncio
+
+import pytest
+
+from src.domain.schemas.agent import AgentDefinition
+from src.domain.schemas.agent_execution import AgentExecutionLimits
+from src.domain.schemas.identity import Identity
+from src.runtimes.agent.adapters.tool import CapabilityToolExecutionAdapter
+from src.runtimes.agent.contracts.context import AgentExecutionContext
+from src.runtimes.agent.contracts.inference import (
+    InferenceMessage,
+    InferenceRequest,
+    InferenceResponse,
+)
+from src.runtimes.agent.contracts.tool import ToolExecutionRequest
+
+
+def make_context() -> AgentExecutionContext:
+    return AgentExecutionContext.create(
+        execution_id="exec-adapter",
+        agent_id="agent-1",
+        session_id="session-1",
+        correlation_id="corr-1",
+        identity=Identity(
+            user_id="user-1",
+            auth_type="api_key",
+            scopes=set(),
+        ),
+        limits=AgentExecutionLimits(
+            max_iterations=4,
+            max_tool_calls=8,
+            timeout_seconds=30,
+        ),
+        input={"prompt": "hello"},
+        agent=AgentDefinition(
+            name="agent-1",
+            goal="test",
+            instruction="test",
+            tools=["fast", "slow"],
+        ),
+        now_monotonic=100,
+    )
+
+
+def test_context_enrichment_does_not_change_existing_execution_contract():
+    context = make_context()
+    assert context.task_id is None
+    assert context.input == {"prompt": "hello"}
+    assert context.trace_id
+
+
+@pytest.mark.asyncio
+async def test_tool_adapter_preserves_input_order_with_bounded_concurrency():
+    started = 0
+    peak = 0
+    lock = asyncio.Lock()
+
+    class FakeCapabilityRuntime:
+        async def execute_capability(self, **kwargs):
+            nonlocal started, peak
+            async with lock:
+                started += 1
+                peak = max(peak, started)
+            await asyncio.sleep(0.01 if kwargs["capability_id"] == "a" else 0)
+            async with lock:
+                started -= 1
+            class Result:
+                invocation_id = kwargs["metadata"]["invocation_id"]
+                output = kwargs["capability_id"]
+                metadata = {}
+            return Result()
+
+    adapter = CapabilityToolExecutionAdapter(FakeCapabilityRuntime())
+    context = make_context()
+    requests = [
+        ToolExecutionRequest(
+            execution_id=context.execution_id,
+            iteration=1,
+            invocation_id=f"inv-{name}",
+            tool_call_id=f"call-{name}",
+            capability_id=name,
+            arguments={},
+            metadata={"invocation_id": f"inv-{name}"},
+        )
+        for name in ("a", "b", "c")
+    ]
+
+    results = await adapter.execute_many(context, requests, max_parallel=2)
+
+    assert peak <= 2
+    assert [result.capability_id for result in results] == ["a", "b", "c"]
+
+
+@pytest.mark.asyncio
+async def test_provider_adapter_contract_is_provider_neutral():
+    from src.runtimes.agent.adapters.inference import ProviderInferenceAdapter
+
+    class Handler:
+        async def execute_with_fallback(self, http_client, body):
+            from src.domain.schemas.response import GatewayChoice, GatewayResponse
+            from src.domain.schemas.message import GatewayMessage
+
+            return GatewayResponse(
+                id="gateway-1",
+                model="mock-model",
+                provider="mock",
+                choices=[
+                    GatewayChoice(
+                        index=0,
+                        finish_reason="stop",
+                        message=GatewayMessage(
+                            role="assistant",
+                            content="hello",
+                        ),
+                    )
+                ],
+            )
+
+    class Runtime:
+        chat_handler = Handler()
+
+    adapter = ProviderInferenceAdapter(Runtime(), object())
+    response = await adapter.complete(
+        InferenceRequest(
+            request_id="req-1",
+            execution_id="exec-1",
+            iteration=1,
+            messages=[{"role": "user", "content": "hello"}],
+        )
+    )
+
+    assert isinstance(response, InferenceResponse)
+    assert isinstance(response.message, InferenceMessage)
+    assert response.provider == "mock"
+    assert response.message.content == "hello"
