@@ -0,0 +1,105 @@
+from __future__ import annotations
+
+import json
+from typing import Any
+
+from ..contracts.inference import (
+    InferenceMessage,
+    InferencePort,
+    InferenceRequest,
+    InferenceResponse,
+    InferenceToolCall,
+    InferenceUsage,
+)
+
+
+class ProviderInferenceAdapter(InferencePort):
+    """Provider-neutral adapter over the existing ProviderRuntime chat path."""
+
+    def __init__(self, provider_runtime: Any, http_client: Any):
+        self._provider_runtime = provider_runtime
+        self._http_client = http_client
+
+    async def complete(self, request: InferenceRequest) -> InferenceResponse:
+        handler = getattr(self._provider_runtime, "chat_handler", None)
+        if handler is None:
+            raise RuntimeError("ProviderRuntime chat handler is not initialized.")
+
+        body = {
+            "model": request.model or "",
+            "messages": [dict(message) for message in request.messages],
+            "tools": [
+                {
+                    "type": "function",
+                    "function": {
+                        "name": tool.name,
+                        "description": tool.description,
+                        "parameters": tool.parameters,
+                    },
+                }
+                for tool in request.tools
+            ],
+            "metadata": dict(request.metadata),
+        }
+        if request.temperature is not None:
+            body["config"] = {
+                "temperature": request.temperature,
+                "max_tokens": request.max_output_tokens,
+            }
+        elif request.max_output_tokens is not None:
+            body["config"] = {"max_tokens": request.max_output_tokens}
+
+        response = await handler.execute_with_fallback(self._http_client, body)
+        if not response.choices:
+            raise ValueError("Provider returned an empty choice list.")
+
+        choice = response.choices[0]
+        gateway_message = choice.message
+        tool_calls = []
+        for call in gateway_message.tool_calls or []:
+            raw_arguments = call.function.arguments or "{}"
+            try:
+                arguments = json.loads(raw_arguments)
+            except (TypeError, json.JSONDecodeError) as exc:
+                raise ValueError(
+                    f"Provider returned malformed tool arguments for '{call.function.name}'."
+                ) from exc
+            if not isinstance(arguments, dict):
+                raise ValueError(
+                    f"Tool arguments for '{call.function.name}' must decode to an object."
+                )
+            tool_calls.append(
+                InferenceToolCall(
+                    id=call.id,
+                    name=call.function.name,
+                    arguments=arguments,
+                )
+            )
+
+        usage = getattr(response, "usage", None)
+        inference_usage = InferenceUsage(
+            prompt_tokens=getattr(usage, "prompt_tokens", 0),
+            completion_tokens=getattr(usage, "completion_tokens", 0),
+            total_tokens=getattr(usage, "total_tokens", 0),
+        )
+
+        finish_reason = choice.finish_reason
+        finish_reason_value = getattr(finish_reason, "value", finish_reason)
+
+        return InferenceResponse(
+            request_id=request.request_id,
+            execution_id=request.execution_id,
+            iteration=request.iteration,
+            message=InferenceMessage(
+                role=gateway_message.role,
+                content=gateway_message.content,
+                tool_calls=tool_calls,
+                metadata=getattr(gateway_message, "metadata", {}) or {},
+            ),
+            finish_reason=finish_reason_value,
+            usage=inference_usage,
+            provider=response.provider,
+            model=response.model,
+            metadata=dict(getattr(response, "metadata", {}) or {}),
+        )
