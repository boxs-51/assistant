@@ -0,0 +1,116 @@
+from __future__ import annotations
+
+import asyncio
+import uuid
+from typing import Any, Sequence
+
+from ..contracts.context import AgentExecutionContext
+from ..contracts.tool import (
+    ToolExecutionPort,
+    ToolExecutionRequest,
+    ToolExecutionResult,
+)
+
+
+class CapabilityToolExecutionAdapter(ToolExecutionPort):
+    """Provider-independent adapter over CapabilityRuntime.
+
+    Concurrency is explicitly bounded and result ordering follows the input
+    request ordering, never completion ordering.
+    """
+
+    def __init__(self, capability_runtime: Any):
+        self._capability_runtime = capability_runtime
+
+    async def execute(
+        self,
+        context: AgentExecutionContext,
+        request: ToolExecutionRequest,
+    ) -> ToolExecutionResult:
+        if request.execution_id != context.execution_id:
+            raise ValueError("Tool request execution_id does not match execution context.")
+
+        context.ensure_active()
+        try:
+            capability_result = await self._capability_runtime.execute_capability(
+                capability_id=request.capability_id,
+                arguments=request.arguments,
+                identity=context.identity,
+                execution_id=context.execution_id,
+                request_id=context.request_id,
+                session_id=context.session_id,
+                workflow_id=context.workflow_id,
+                timeout_seconds=context.remaining_seconds,
+                metadata={
+                    **context.metadata,
+                    **request.metadata,
+                    "tool_call_id": request.tool_call_id,
+                    "invocation_id": request.invocation_id,
+                },
+            )
+            return ToolExecutionResult(
+                execution_id=context.execution_id,
+                iteration=request.iteration,
+                invocation_id=capability_result.invocation_id,
+                tool_call_id=request.tool_call_id,
+                capability_id=request.capability_id,
+                success=True,
+                output=capability_result.output,
+                metadata=dict(capability_result.metadata),
+            )
+        except asyncio.CancelledError:
+            raise
+        except Exception as exc:
+            return ToolExecutionResult(
+                execution_id=context.execution_id,
+                iteration=request.iteration,
+                invocation_id=request.invocation_id,
+                tool_call_id=request.tool_call_id,
+                capability_id=request.capability_id,
+                success=False,
+                error_code=getattr(exc, "code", type(exc).__name__),
+                error_message=str(exc),
+                retryable=bool(getattr(exc, "retryable", False)),
+                metadata={
+                    "exception_type": type(exc).__name__,
+                },
+            )
+
+    async def execute_many(
+        self,
+        context: AgentExecutionContext,
+        requests: Sequence[ToolExecutionRequest],
+        *,
+        max_parallel: int,
+    ) -> Sequence[ToolExecutionResult]:
+        if max_parallel < 1:
+            raise ValueError("max_parallel must be >= 1.")
+
+        semaphore = asyncio.Semaphore(max_parallel)
+
+        async def run_one(request: ToolExecutionRequest) -> ToolExecutionResult:
+            async with semaphore:
+                return await self.execute(context, request)
+
+        # asyncio.gather preserves request ordering by contract.
+        return list(await asyncio.gather(*(run_one(request) for request in requests)))
+
+    @staticmethod
+    def new_request(
+        *,
+        context: AgentExecutionContext,
+        iteration: int,
+        tool_call_id: str,
+        capability_id: str,
+        arguments: dict[str, Any],
+        metadata: dict[str, Any] | None = None,
+    ) -> ToolExecutionRequest:
+        return ToolExecutionRequest(
+            execution_id=context.execution_id,
+            iteration=iteration,
+            invocation_id=f"inv_{uuid.uuid4().hex}",
+            tool_call_id=tool_call_id,
+            capability_id=capability_id,
+            arguments=dict(arguments),
+            metadata=dict(metadata or {}),
+        )
