+    req = request(context, "call-1", "tool.a")
+
+    conflicting = ToolExecutionRequest(
+        execution_id=req.execution_id,
+        iteration=req.iteration,
+        invocation_id=req.invocation_id,
+        tool_call_id=req.tool_call_id,
