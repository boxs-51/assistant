async def test_capability_runtime_unsubscribes_on_stop_and_can_reinitialize():
    class Bus:
        def __init__(self):
            self.handlers = []
        def subscribe(self, event_name, handler):
            self.handlers.append((event_name, handler))
        def unsubscribe(self, event_name, handler):
            self.handlers = [x for x in self.handlers if x != (event_name, handler)]

    from src.kernel.base import RuntimeContext
    from types import SimpleNamespace

    runtime = CapabilityRuntime()
    bus = Bus()
    ctx = SimpleNamespace(event_bus=bus)
    await runtime.initialize(ctx)
    assert len(bus.handlers) == 1
    await runtime.stop()
    assert len(bus.handlers) == 0
    await runtime.initialize(ctx)
    assert len(bus.handlers) == 1

