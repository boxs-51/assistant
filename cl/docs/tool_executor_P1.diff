+class ExecutionCancelled(Exception):
+    """Raised when an agent execution is cancelled or its deadline expires."""
+
+
+class ExecutionContext:
+    """Immutable identity + cooperative cancellation/deadline context for one execution."""
+
+    def __init__(
+        self,
+        conversation_id: str,
+        execution_id: str,
+        session: Any,
+        cancellation_event: Optional[threading.Event] = None,
+        deadline_monotonic: Optional[float] = None,
+    ):
+        self.conversation_id = conversation_id
+        self.execution_id = execution_id
+        self.session = session
+        self.cancellation_event = cancellation_event or threading.Event()
+        self.deadline_monotonic = deadline_monotonic
+
+    @property
+    def cancelled(self) -> bool:
+        if self.cancellation_event.is_set():
+            return True
+        return (
+            self.deadline_monotonic is not None
+            and time.monotonic() >= self.deadline_monotonic
+        )
+
+    def remaining_seconds(self) -> Optional[float]:
+        if self.deadline_monotonic is None:
+            return None
+        return max(0.0, self.deadline_monotonic - time.monotonic())
+
+    def check_cancelled(self) -> None:
+        if self.cancellation_event.is_set():
+            raise ExecutionCancelled(
+                f"Execution '{self.execution_id}' was cancelled."
+            )
+        if (
+            self.deadline_monotonic is not None
+            and time.monotonic() >= self.deadline_monotonic
+        ):
+            self.cancellation_event.set()
+            raise ExecutionCancelled(
+                f"Execution '{self.execution_id}' exceeded its deadline."
+            )
+
