             return record
+
+    async def load_execution(self, execution_id: str):
+        async with self.uow_factory() as uow:
+            record = await uow.agents.get_execution(execution_id)
+            await uow.commit()
+            return record
+
+    async def load_iteration(self, execution_id: str, *, iteration_id: str | None = None, iteration_number: int | None = None):
+        async with self.uow_factory() as uow:
+            if iteration_id is not None:
+                return await uow.agents.get_iteration(iteration_id)
+            iterations = await uow.agents.list_iterations(execution_id)
+            if not iterations:
+                return None
+            if iteration_number is not None:
+                return next((i for i in iterations if i.iteration == iteration_number), None)
+            return max(iterations, key=lambda i: i.iteration)
+
+    async def resume_execution(self, execution_id: str):
+        async with self.uow_factory() as uow:
+            execution = await uow.agents.get_execution(execution_id)
+            if execution is None:
+                return None
+            iterations = await uow.agents.list_iterations(execution_id)
+            latest_iteration = max(iterations, key=lambda i: i.iteration, default=None) if iterations else None
+            pending_tool_calls = []
+            if latest_iteration is not None:
+                pending_tool_calls = [
+                    {
+                        "execution_id": item.execution_id,
+                        "iteration_id": item.iteration_id,
+                        "invocation_id": item.invocation_id,
+                        "tool_call_id": item.tool_call_id,
+                        "capability_id": item.capability_id,
+                        "arguments": item.arguments,
+                        "status": item.status,
+                    }
+                    for item in await uow.agents.list_tool_calls(execution_id, latest_iteration.id)
+                    if item.status != "COMPLETED"
+                ]
+            await uow.commit()
+            return {
+                "execution_id": execution.id,
+                "state": execution.state,
+                "current_iteration": latest_iteration.iteration if latest_iteration else 0,
+                "pending_tool_calls": pending_tool_calls,
+            }

